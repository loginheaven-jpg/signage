{
  "name": "digital-signage-host",
  "version": "1.10.0",
  "description": "디지털 게시판 호스트 서버 (MVP)",
  "main": "server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.js",
    "test": "node --test ../tests/*.test.js",
    "test:photo-library": "node ../scripts/smoke-photo-library.cjs",
    "test:camera-ui": "node ../scripts/smoke-photo-ui.cjs && node ../scripts/smoke-camera-communications.cjs && node ../scripts/smoke-camera-reliability.cjs && node ../scripts/smoke-camera-fast.cjs && node ../scripts/smoke-camera-video.cjs && node ../scripts/smoke-camera-bulk.cjs",
    "test:camera-background": "node ../scripts/smoke-camera-background.cjs",
    "test:admin-ui": "node ../scripts/smoke-cuesheets.cjs"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "exifr": "^7.1.3",
    "express": "^4.18.2",
    "file-type": "^22.1.1",
    "googleapis": "^173.0.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^10.0.13",
    "sharp": "^0.35.5",
    "uuid": "^9.0.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
